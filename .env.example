# --- LLM provider -----------------------------------------------------------
# Provider: "anthropic" (default) or "openai".
LLM_PROVIDER=anthropic

# Model id. Defaults to a current Claude Sonnet when unset. For OpenAI, e.g.
# gpt-4o-mini. You may also use a provider-qualified id like
# "anthropic/claude-sonnet-4-5" or "openai/gpt-4o-mini".
LLM_MODEL=claude-sonnet-4-5

# Sampling temperature.
LLM_TEMPERATURE=0.2

# API keys - NEVER commit real keys. Set the one matching your provider.
# A generic LLM_API_KEY takes precedence if set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_API_KEY=

# --- Scraper ----------------------------------------------------------------
SCRAPER_USER_AGENT=competitor-intel-crew/0.1 (+https://github.com/nasirovsh/competitor-intel-crew)
SCRAPER_TIMEOUT=20
SCRAPER_RPS=1.0
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_MAX_LINKS=1

# --- Scrape cache -----------------------------------------------------------
SCRAPE_CACHE_ENABLED=true
SCRAPE_CACHE_DIR=.cache/scrape
SCRAPE_CACHE_TTL=86400

# --- Quality / orchestrator decision thresholds -----------------------------
MIN_CONTENT_WORDS=120
MAX_SCRAPE_ATTEMPTS=2
FAITHFULNESS_THRESHOLD=0.7
MAX_REVISION_ATTEMPTS=2

# --- Misc -------------------------------------------------------------------
CIC_VERBOSE=false
